<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- SYNTHETIC ASSUMPTION: hourly sweep of the fixture 48-hour TTL. -->
    <record id="ir_cron_expire_reservations" model="ir.cron">
        <field name="name">FIXTURE SPH reservation expiry</field>
        <field name="model_id" ref="model_sph_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
