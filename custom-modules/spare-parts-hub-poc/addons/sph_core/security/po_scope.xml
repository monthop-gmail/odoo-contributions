<odoo>
    <!-- Explicit exception only: no user/role receives this group in data. -->
    <record id="group_sph_po_hub" model="res.groups">
        <field name="name">SPH explicit all-center PO access</field>
    </record>
    <record id="scope_purchase_order" model="ir.rule">
        <field name="name">SPH global PO center ownership</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('sph_core.group_sph_po_hub') else [('sph_center_id', 'in', user.sph_center_ids.ids)]</field>
    </record>
    <record id="scope_purchase_line" model="ir.rule">
        <field name="name">SPH global PO line ownership</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('sph_core.group_sph_po_hub') else [('order_id.sph_center_id', 'in', user.sph_center_ids.ids)]</field>
    </record>
    <record id="scope_purchase_mail" model="ir.rule">
        <field name="name">SPH PO mail ownership projection</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="domain_force">['|', ('model', '!=', 'purchase.order'), ('sph_po_visible', '=', True)]</field>
    </record>
    <record id="scope_purchase_attachment" model="ir.rule">
        <field name="name">SPH PO attachment ownership projection</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">['|', ('res_model', '!=', 'purchase.order'), ('sph_po_visible', '=', True)]</field>
    </record>
</odoo>
