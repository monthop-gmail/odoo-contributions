<odoo>
<record id="group_sph_reader" model="res.groups"><field name="name">SPH fixture context reader</field></record>
<record id="scope_sale_order" model="ir.rule"><field name="name">SPH global sale.order scope</field><field name="model_id" ref="sale.model_sale_order"/><field name="domain_force">[('sph_center_id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_sale_order_line" model="ir.rule"><field name="name">SPH global sale.order.line scope</field><field name="model_id" ref="sale.model_sale_order_line"/><field name="domain_force">[('sph_center_id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_product_pricelist" model="ir.rule"><field name="name">SPH global product.pricelist scope</field><field name="model_id" ref="product.model_product_pricelist"/><field name="domain_force">[('sph_center_id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_product_pricelist_item" model="ir.rule"><field name="name">SPH global product.pricelist.item scope</field><field name="model_id" ref="product.model_product_pricelist_item"/><field name="domain_force">[('pricelist_id.sph_center_id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_stock_picking" model="ir.rule"><field name="name">SPH global stock.picking scope</field><field name="model_id" ref="stock.model_stock_picking"/><field name="domain_force">[('sph_center_id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_sph_center" model="ir.rule"><field name="name">SPH global sph.center scope</field><field name="model_id" ref="model_sph_center"/><field name="domain_force">[('id', 'in', user.sph_center_ids.ids)] if user._sph_scoped() else [(1, '=', 1)]</field></record>
<record id="scope_stock_quant" model="ir.rule"><field name="name">SPH no raw stock.quant</field><field name="model_id" ref="stock.model_stock_quant"/><field name="domain_force">[(1, "=", 0)] if user._sph_scoped() else [(1, "=", 1)]</field></record>
<record id="scope_stock_move" model="ir.rule"><field name="name">SPH no raw stock.move</field><field name="model_id" ref="stock.model_stock_move"/><field name="domain_force">[(1, "=", 0)] if user._sph_scoped() else [(1, "=", 1)]</field></record>
<record id="scope_stock_move_line" model="ir.rule"><field name="name">SPH no raw stock.move.line</field><field name="model_id" ref="stock.model_stock_move_line"/><field name="domain_force">[(1, "=", 0)] if user._sph_scoped() else [(1, "=", 1)]</field></record>
</odoo>
